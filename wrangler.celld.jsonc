{
  // Trimmed celld variant of wrangler.jsonc. As of celld v0.4.0 the only
  // bindings `celld deploy` rejects are `ai`, `browser`, `send_email`,
  // `containers` — and `routes`, which is Cloudflare platform surface. KV, R2,
  // D1, Queues, Workflows and assets are all accepted.
  //
  // What is absent from this file is therefore a DECISION in every case, not a
  // platform limit. R2 is the one deliberate omission: celld's R2 binding
  // stores objects in the fleet bucket and cannot presign, and Nadi hands out
  // presigned URLs that a SANDBOX fetches directly, outside the Worker — so
  // the S3 path in src/storage/ is required regardless and a binding would
  // only add a second one. See docs/self-hosting-celld.md.
  "name": "nadi",
  "main": "src/index.ts",
  "compatibility_date": "2026-05-01",
  "compatibility_flags": ["nodejs_compat"],
  // celld serves the SPA itself, exactly as Cloudflare does. Before this,
  // Caddy owned the split between static files and Worker routes, with the
  // list of Worker paths hand-copied out of src/index.ts — and a route that
  // drifted out of that list was answered with the SPA shell and a 200, which
  // no log records and no status code betrays.
  "assets": {
    "directory": "web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true,
  },
  "durable_objects": {
    "bindings": [
      { "name": "THINK_THREAD_AGENT", "class_name": "ThinkThreadAgent" },
      { "name": "WORKSPACE_MCP_AGENT", "class_name": "WorkspaceMcpAgent" },
      { "name": "USER_HUB", "class_name": "UserHub" },
      { "name": "VOICE_AGENT", "class_name": "VoiceAgent" },
      { "name": "AGENT_SANDBOX", "class_name": "AgentSandbox" },
    ],
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["WorkspaceMcpAgent"] },
    { "tag": "v2", "new_sqlite_classes": ["UserHub"] },
    { "tag": "v3", "new_sqlite_classes": ["ThinkThreadAgent"] },
    { "tag": "v4", "new_sqlite_classes": ["VoiceAgent"] },
    { "tag": "v5", "new_sqlite_classes": ["AgentSandbox"] },
    // v5 created RegistryDatabase, the DO that held the whole registry while
    // celld had no D1. celld v0.3.0 has one, so the registry is a real
    // `d1_databases` binding below and the class is gone.
    // v6 created CelldTicker, a per-minute alarm DO that stood in for
    // scheduled() while celld rejected `triggers`. celld v0.3.0 runs cron
    // natively, so the class and its tag are gone. An upgraded deployment
    // leaves an orphaned `CelldTicker` cell in the fleet bucket, and it is NOT
    // free: the cell carries a persisted alarm celld keeps retrying against a
    // class nothing exports, measured at ~16 attempts/second forever. Delete
    // the cell prefix and restart the node — docs/self-hosting-celld.md,
    // "Upgrading celld".
  ],
  // celld v0.3.0 runs D1, and a D1 database is a cell — so this gets the same
  // fencing, replication and durable write acknowledgement as any other cell.
  // `database_name` is the identity when no `database_id` is given. Schema is
  // applied with `celld d1 migrations apply` from the SAME migrations/ that
  // drizzle-kit generates for Cloudflare; there is no second history.
  "d1_databases": [{ "binding": "REGISTRY_DB", "database_name": "nadi-registry" }],
  // Workspace secrets. celld v0.4.0 runs KV natively: a namespace is a cell of
  // its own, so it gets the same fencing, replication and durable write
  // acknowledgement as the registry — one writer, strongly consistent, no edge
  // cache. Before this, celld had no KV and `RegistryKV` faked the binding over
  // a `celld_kv` table in the registry; that facade is gone and both platforms
  // now use the same binding.
  //
  // `id` is the namespace identity. celld accepts any stable string where
  // Cloudflare wants a hex id.
  "kv_namespaces": [{ "binding": "SECRETS_KV", "id": "nadi-secrets" }],
  // Same expressions as wrangler.jsonc — scheduled() dispatches on
  // controller.cron, so they must stay in step with AUTOMATA_CRON /
  // AUTO_ARCHIVE_CRON in src/automata/fire-policy.ts. celld numbers
  // day-of-week Cloudflare's way (1 = Sunday) and refuses 0, a descending
  // range, and a `*` inside a list; both expressions here use `*` for the
  // day-of-week field, so none of that bites.
  "triggers": { "crons": ["0 3 * * *", "* * * * *"] },
  "vars": {
    "NADI_EDITION": "self-hosted",
    "NADI_PLATFORM": "celld",
    "APP_NAME": "Nadi",
    "APP_BASE_URL": "http://localhost:8080",
    "ARTIFACTS_HOST": "artifacts.localhost",
    "DEFAULT_WORKSPACE_ID": "default",
    // Written into every new account's default agent (agents.provider/model are
    // NOT NULL). Omitting them makes first sign-in fail with an opaque
    // constraint error after the user row is already created.
    "DEFAULT_MODEL_PROVIDER": "openai-oauth",
    "DEFAULT_MODEL": "gpt-5.4-mini",
    "LOG_LEVEL": "debug",
    // Everything below works the same on celld as on Cloudflare and is kept in
    // step with wrangler.jsonc by scripts/check-wrangler-parity.mjs. A var that
    // genuinely cannot work here belongs in that script's CLOUDFLARE_ONLY_VARS
    // with a reason, not silently absent from this file.
    "CANONICAL_HOST": "app.example.com",
    "LEGACY_HOSTS": "legacy.example.com",
    // Process watchers + subagent dispatch. Fail closed unless explicitly enabled.
    "BACKGROUND_WORK_ENABLED": "false",
    // From-address for sign-in email. celld has no Cloudflare EMAIL binding, so
    // delivery goes over HTTP via RESEND_API_KEY (a secret); with neither set,
    // AUTH_OTP_LOG_FALLBACK writes the code to the log for local use.
    "AUTH_EMAIL_FROM": "signin@example.com",
    "WHITELISTED_EMAILS": "",
    "SUPERUSER_EMAILS": "you@example.com",
    "FEEDBACK_ADMIN_EMAILS": "you@example.com",
    // GitHub App (private repo clone/push). Works on celld: the RS256 JWT is
    // signed in-repo (src/github/rs256.ts) because celld's WebCrypto has no
    // RSA. The private key must be PKCS#8 — convert a PKCS#1 key with
    // `openssl pkcs8 -topk8 -nocrypt`.
    "GITHUB_APP_ID": "",
    "GITHUB_APP_CLIENT_ID": "",
    "GITHUB_APP_SLUG": "",
    "CODEX_DIRECT_ENABLED": "false",
    "POSTHOG_HOST": "https://us.i.posthog.com",
    "POSTHOG_CAPTURE_CONTENT": "true",
  },
}
