{
  // Trimmed celld variant of wrangler.jsonc — celld deploy rejects
  // r2_buckets, kv_namespaces, ai, browser, send_email and containers.
  // Everything dropped here is a binding seam that tasks 04/05/09/11 own.
  //
  // celld v0.3.0 also accepts `d1_databases` and `assets`, which this file
  // does NOT use yet: the registry still runs on the RegistryDatabase DO, and
  // Caddy still serves the SPA. Both are live opportunities, not oversights —
  // see docs/self-hosting-celld.md.
  "name": "nadi",
  "main": "src/index.ts",
  "compatibility_date": "2026-05-01",
  "compatibility_flags": ["nodejs_compat"],
  "durable_objects": {
    "bindings": [
      { "name": "REGISTRY_DO", "class_name": "RegistryDatabase" },
      { "name": "THINK_THREAD_AGENT", "class_name": "ThinkThreadAgent" },
      { "name": "WORKSPACE_MCP_AGENT", "class_name": "WorkspaceMcpAgent" },
      { "name": "USER_HUB", "class_name": "UserHub" },
      { "name": "VOICE_AGENT", "class_name": "VoiceAgent" },
    ],
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["WorkspaceMcpAgent"] },
    { "tag": "v2", "new_sqlite_classes": ["UserHub"] },
    { "tag": "v3", "new_sqlite_classes": ["ThinkThreadAgent"] },
    { "tag": "v4", "new_sqlite_classes": ["VoiceAgent"] },
    { "tag": "v5", "new_sqlite_classes": ["RegistryDatabase"] },
    // v6 created CelldTicker, a per-minute alarm DO that stood in for
    // scheduled() while celld rejected `triggers`. celld v0.3.0 runs cron
    // natively, so the class and its tag are gone. An upgraded deployment
    // leaves one orphaned `CelldTicker` cell in the fleet bucket; nothing
    // references it and it costs one idle cell's storage.
  ],
  // Same expressions as wrangler.jsonc — scheduled() dispatches on
  // controller.cron, so they must stay in step with AUTOMATA_CRON /
  // AUTO_ARCHIVE_CRON in src/automata/fire-policy.ts. celld numbers
  // day-of-week Cloudflare's way (1 = Sunday) and refuses 0, a descending
  // range, and a `*` inside a list; both expressions here use `*` for the
  // day-of-week field, so none of that bites.
  "triggers": { "crons": ["0 3 * * *", "* * * * *"] },
  "vars": {
    "NADI_EDITION": "self-hosted",
    "NADI_PLATFORM": "celld",
    "APP_NAME": "Nadi",
    "APP_BASE_URL": "http://localhost:8080",
    "ARTIFACTS_HOST": "artifacts.localhost",
    "DEFAULT_WORKSPACE_ID": "default",
    // Written into every new account's default agent (agents.provider/model are
    // NOT NULL). Omitting them makes first sign-in fail with an opaque
    // constraint error after the user row is already created.
    "DEFAULT_MODEL_PROVIDER": "openai-oauth",
    "DEFAULT_MODEL": "gpt-5.4-mini",
    "LOG_LEVEL": "debug",
    // Everything below works the same on celld as on Cloudflare and is kept in
    // step with wrangler.jsonc by scripts/check-wrangler-parity.mjs. A var that
    // genuinely cannot work here belongs in that script's CLOUDFLARE_ONLY_VARS
    // with a reason, not silently absent from this file.
    "CANONICAL_HOST": "app.example.com",
    "LEGACY_HOSTS": "legacy.example.com",
    // Process watchers + subagent dispatch. Fail closed unless explicitly enabled.
    "BACKGROUND_WORK_ENABLED": "false",
    // From-address for sign-in email. celld has no Cloudflare EMAIL binding, so
    // delivery goes over HTTP via RESEND_API_KEY (a secret); with neither set,
    // AUTH_OTP_LOG_FALLBACK writes the code to the log for local use.
    "AUTH_EMAIL_FROM": "signin@example.com",
    "WHITELISTED_EMAILS": "",
    "SUPERUSER_EMAILS": "you@example.com",
    "FEEDBACK_ADMIN_EMAILS": "you@example.com",
    // GitHub App (private repo clone/push). Works on celld: the RS256 JWT is
    // signed in-repo (src/github/rs256.ts) because celld's WebCrypto has no
    // RSA. The private key must be PKCS#8 — convert a PKCS#1 key with
    // `openssl pkcs8 -topk8 -nocrypt`.
    "GITHUB_APP_ID": "",
    "GITHUB_APP_CLIENT_ID": "",
    "GITHUB_APP_SLUG": "",
    "CODEX_DIRECT_ENABLED": "false",
    "POSTHOG_HOST": "https://us.i.posthog.com",
    "POSTHOG_CAPTURE_CONTENT": "true",
  },
}
