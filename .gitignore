# Note: worker-configuration.d.ts IS committed (needed for typecheck in CI) and
# is NOT auto-regenerated on install. `wrangler types` infers secret + var types
# from `.dev.vars`, which is gitignored — so regenerating without it (worktrees,
# CI, fresh clones) silently drops all secret bindings and narrows vars. To
# refresh after a wrangler.jsonc binding change, run `pnpm types` from a checkout
# that has `.dev.vars` (i.e. the main checkout, NOT a worktree), then commit.
# Secrets themselves are the source-of-truth-typed in src/env.ts. migrations/ ARE committed.

# MSW's generated service worker, written by `msw init web/public/`. It is only
# needed by the dev-only mock app (mock.html); Vite copies web/public/ verbatim
# into dist, so committing it would ship it in every production build. Untracked
# means CI and deploy (fresh checkouts) never see it at all. Regenerate on
# demand with `pnpm --filter @nadi/web exec msw init public/`.
web/public/mockServiceWorker.js

# Visual brainstorming companion
.superpowers/

# Local design mockups / scratch
scratch/

# Local git worktrees
.worktrees/

# Your own production config, derived from wrangler.prod.example.jsonc.
# Deployment-specific ids belong to you, not to the repo.
wrangler.prod.jsonc

# Reasonix host session state (task lists, subagent snapshots). Never part of
# the repo; without this, oxfmt picks up its JSON snapshots and fmt:check fails.
.reasonix/

# Local celld smoke-test config, generated from .env.local (contains secrets).
wrangler.smoke.jsonc

# scripts/push-catcher.mjs generates its subscription keypair and a self-signed
# TLS cert here on first run. Local-only by construction: a committed
# subscription private key would be a shared secret that decrypts nothing real.
.push-catcher/
