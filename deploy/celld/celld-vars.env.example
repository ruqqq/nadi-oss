# Application configuration and secrets, delivered to the Worker by celld.
# Copy to celld-vars.env and edit. Keep it out of version control.
#
# THIS FILE IS `KEY=VALUE` LINES, NOT JSON. A JSON file is accepted silently
# and delivers nothing, after which the app behaves as though every single
# variable is unset — a confusing failure worth avoiding by not causing it.
#
# Non-secret configuration lives in wrangler.celld.jsonc and is already set.

# --- required ---------------------------------------------------------------
# Generate each with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SECRETS_STORE_KEK_RAW_B64=
BETTER_AUTH_SECRET=

# The HMAC secret for tool approvals (SECURITY.md). `Env` types it as required
# and every other deployment path sets it — .dev.vars.example, the first-deploy
# skill, scripts/setup-local-env.mjs — so the celld path setting it keeps the
# platforms honest. Generate it randomly, per deployment, like the two above.
TOOL_APPROVAL_SECRET=

# Better Auth derives its cookie settings from this, so it must be the public
# https:// URL. Getting it wrong gives cookies that never stick, which presents
# as "sign-in succeeds and then I am signed out".
APP_BASE_URL=https://app.example.com

# The first account must be listed here or the sign-in is accepted and quietly
# routed to a waiting list instead. Nadi is invite-only.
SUPERUSER_EMAILS=you@example.com

# --- S3, as the WORKER sees it ----------------------------------------------
# Not the same value as S3_ENDPOINT_INTERNAL in .env: attachment downloads 302
# the browser to a presigned URL built from this, so it must be an endpoint the
# browser can resolve. With bundled MinIO that means the public S3_HOST.
S3_ENDPOINT=https://s3.example.com
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_ATTACHMENTS_BUCKET_NAME=nadi-attachments
S3_BACKUP_BUCKET_NAME=nadi-attachments

# --- email ------------------------------------------------------------------
# Sign-in is an emailed one-time code. Without a provider, outbound mail is a
# no-op: the request returns 200, the code goes nowhere, and a warning is
# logged. There is no password fallback, so on a server this is effectively
# required.
RESEND_API_KEY=
AUTH_EMAIL_FROM=signin@example.com

# Writes the sign-in code to the log instead of emailing it. LOCAL ONLY —
# anyone who can read the log can sign in as anyone. Do not set this on a
# server you did not just build five minutes ago.
# AUTH_OTP_LOG_FALLBACK=true

# --- web push (optional) ----------------------------------------------------
# Generate with `npx web-push generate-vapid-keys`. Both the raw 32-byte scalar
# it emits and PKCS#8 are accepted.
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:you@example.com

# --- GitHub App (optional) --------------------------------------------------
# For private-repo clone/push from sandboxes. The key MUST be PKCS#8; convert a
# PKCS#1 key (BEGIN RSA PRIVATE KEY) with:
#   openssl pkcs8 -topk8 -nocrypt -in github-app.pem -out github-app-pkcs8.pem
# GITHUB_APP_PRIVATE_KEY=
# GITHUB_APP_CLIENT_SECRET=

# --- sandbox ----------------------------------------------------------------
# REQUIRED on celld. The provider each NEW workspace is provisioned with.
# Unset resolves to `cloudflare` (src/compute/config.ts), which can never work
# here: celld rejects the `containers` binding outright and binds no sandbox
# classes, so the account is created with a sandbox whose first use fails with
#   compute_unavailable: cloudflare_config_missing: NADI_SANDBOX_SMALL,...
# and the whole message submission fails with it — not just the sandbox tools.
#
#   sprites   real sandboxes; needs SPRITES_API_KEY below or a per-workspace
#             key in Settings -> Sandbox
#   daytona   real sandboxes; needs a Daytona key plus an image/snapshot
#   mock      in-memory, no credentials. Process-global state that resets on
#             every node restart, and it runs no real commands — local trials
#             only. It is also the ONLY value that makes `mock` selectable in
#             Settings at all; every other deployment hides it.
#
# This applies to workspaces created AFTER a node restart. An existing
# workspace keeps whatever it was provisioned with and is changed in
# Settings -> Sandbox.
DEFAULT_SANDBOX_PROVIDER=sprites

# Operator-managed credential, used when a workspace has no key of its own.
# A per-workspace key set in Settings takes precedence.
# SPRITES_API_KEY=
# DAYTONA_API_KEY=

# --- model providers --------------------------------------------------------
# Not set here. Provider keys are per-workspace secrets entered in Settings
# once you are signed in, not environment variables. Workers AI is unavailable
# on celld, so you do need a key for some provider before the app is useful.

# --- debug (optional) -------------------------------------------------------
# Enables /api/debug/*, including the ticker health check. Requests must also
# carry a matching x-debug-token header.
# DEBUG_TOKEN=
