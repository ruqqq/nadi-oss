# Compose configuration for ONE HOST of a celld cluster.
#
#   cp .env.multinode.example .env.multinode    # then edit
#
# Most of this file is identical on every host. Exactly two values are
# per-host, and they are marked PER HOST below. Getting them wrong is the
# likeliest way to end up with three nodes that never find each other.
#
# Pass it explicitly, since Compose only auto-loads a file literally named
# `.env`:
#   docker compose -f docker-compose.multinode.yaml --env-file .env.multinode up -d
#
# Application config and secrets are in celld-vars.env, which must be BYTE
# IDENTICAL on every host. See README.md.

# --- PER HOST: peer identity ------------------------------------------------
# The address the OTHER nodes dial to reach this one. Must be a private
# address they can actually route to — a VPC/private-network IP, a WireGuard
# IP, or a DNS name resolving to one. Peer traffic is UNENCRYPTED.
#
# celld rejects a public IP here unless you set CELLD_UNSAFE_PUBLIC_ADVERTISE=1,
# which you should read as "do not". (It takes 1, not `on` — since v0.2.0 celld
# validates every variable at startup and a bad value stops the node.)
#
# The PORT is 8081, the internal listener — not the public 8080 the Worker is
# served on. celld separated the two planes in v0.2.0.
#
#   host A: 10.0.0.11:8081
#   host B: 10.0.0.12:8081
#   host C: 10.0.0.13:8081
CELLD_ADVERTISE=10.0.0.11:8081

# The local interface the peer port is published on. Set it to this host's
# private IP — the same one in CELLD_ADVERTISE, without the port. Leaving it
# empty binds 0.0.0.0 and exposes the cluster's storage plane to the internet.
PEER_BIND_IP=10.0.0.11

# --- hostnames --------------------------------------------------------------
# Same on every host.
#
# These carry a scheme and it decides whether Caddy runs ACME. `http://` here
# means TLS is terminated UPSTREAM, at your load balancer — which is the
# recommended setup, because HTTP-01 across round-robin DNS fails randomly:
# the challenge request has to land on the same Caddy that started it, and
# with N nodes behind one name it usually does not.
#
# The browser still sees https:// via the LB, so APP_BASE_URL in
# celld-vars.env stays https://. Only Caddy's own view is plain HTTP, on the
# private side of the LB.
#
# If you have no LB and want each node to issue its own certificate, switch to
# a DNS-01 challenge (a Caddy build with your DNS provider's module) rather
# than dropping the scheme. Bare hostnames here select HTTP-01 and will
# flap.
NADI_SITE=http://app.example.com
ARTIFACTS_SITE=http://artifacts.example.com

# With external S3 the browser goes straight to your provider, so nothing
# should route here. Left set only because the Caddyfile references it; point
# it at a name you do not use.
S3_SITE=http://s3.invalid

# Unused while every *_SITE carries a scheme, but Caddy's global `email`
# directive fails to parse when empty and the container will not start.
ACME_EMAIL=you@example.com

# --- buckets and S3 ---------------------------------------------------------
# Same on every host, and this is the point: one fleet bucket IS the cluster.
# Two nodes pointed at different buckets are two separate applications that
# will never discover each other.
#
# Must be external — R2, S3, or a MinIO cluster of its own. There is no
# bundled `minio` profile in the multi-node stack.
CELLD_BUCKET=s3://celld-fleet

# Reachable from every host. Unlike the single-node file, this cannot be a
# Docker service name.
S3_ENDPOINT_INTERNAL=https://s3.us-east-1.amazonaws.com

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1

# --- failover and durability ------------------------------------------------
# Same on every host. These two decide what a node dying costs you, and they
# add up: a peer takes over after this node's lease expires (TTL_MS), then
# restores each cell from its last replication (IDLE_EVICT_S). Everything
# written in the window between is discarded, with no error anywhere.
#
# Worst case is roughly TTL_MS + IDLE_EVICT_S of writes. At the values below
# that is about 45 seconds. It must stay well under the scheduler's 60s tick.
#
# Do NOT drop IDLE_EVICT_S below 31 to shrink that window: the SPA's 30s
# presence heartbeat then cold-starts the UserHub cell on every beat, forever,
# per open tab. See the long note in .env.example.
CELLD_TTL_MS=10000
CELLD_IDLE_EVICT_S=35

# Lets the ticker's cell evict between ticks so its alarm is persisted.
CELLD_ALARM_RESIDENT_MS=1000

# `release` hands cells to a quieter peer under pressure instead of shedding
# them — the behaviour that makes a cluster balance. `sticky` caches locally
# and is the single-node answer.
CELLD_PRESSURE_OWNERSHIP=release
