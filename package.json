{
  "name": "nadi",
  "version": "0.0.1",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --local",
    "deploy": "pnpm web:build && wrangler deploy --config wrangler.prod.jsonc",
    "typecheck": "tsgo --noEmit",
    "types": "wrangler types --strict-vars false && oxfmt worker-configuration.d.ts",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "fmt": "oxfmt .",
    "fmt:check": "oxfmt --check .",
    "test": "node scripts/test-all.mjs",
    "test:unit": "vitest run --project=unit",
    "test:integration": "vitest run --project=integration-fast --project=integration-grouped --project=integration-shared --project=integration-isolated",
    "check:wrangler": "node scripts/check-wrangler-parity.mjs",
    "check": "pnpm run typecheck && pnpm run lint && pnpm run fmt:check && pnpm test && pnpm run web:typecheck",
    "db:generate": "drizzle-kit generate && node scripts/bundle-celld-migrations.mjs",
    "celld:db:bundle": "node scripts/bundle-celld-migrations.mjs",
    "celld:deploy": "node scripts/celld-deploy.mjs",
    "db:migrate:local": "wrangler d1 migrations apply nadi-registry --local",
    "db:migrate:remote": "wrangler d1 migrations apply nadi-registry --remote --config wrangler.prod.jsonc",
    "db:backfill:compute:local": "wrangler d1 execute nadi-registry --local --file scripts/backfills/compute-provider-settings.sql",
    "db:backfill:compute:remote": "wrangler d1 execute nadi-registry --remote --config wrangler.prod.jsonc --file scripts/backfills/compute-provider-settings.sql",
    "db:migrate": "drizzle-kit migrate",
    "db:check": "drizzle-kit check",
    "secret:put": "node scripts/put-workspace-secret.mjs",
    "check:mock-isolation": "node scripts/check-mock-isolation.mjs",
    "web:dev": "pnpm --filter @nadi/web dev",
    "web:mock": "pnpm --filter @nadi/web mock",
    "web:build": "pnpm --filter @nadi/web build",
    "web:typecheck": "pnpm --filter @nadi/web typecheck"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^3.0.88",
    "@ai-sdk/deepseek": "^2.0.51",
    "@ai-sdk/openai": "^3.0.76",
    "@ai-sdk/openai-compatible": "^2.0.63",
    "@ai-sdk/react": "^3.0.204",
    "@cloudflare/ai-chat": "0.8.6",
    "@cloudflare/sandbox": "0.12.3",
    "@cloudflare/think": "0.11.1",
    "@cloudflare/voice": "0.3.3",
    "@daytona/sdk": "^0.193.0",
    "@noble/curves": "1.9.7",
    "@noble/hashes": "2.2.0",
    "@openrouter/ai-sdk-provider": "^2.10.0",
    "@posthog/ai": "^8.2.2",
    "agents": "^0.17.1",
    "ai": "^6.0.0",
    "aws4fetch": "^1.0.20",
    "better-auth": "^1.6.22",
    "cron-parser": "5",
    "drizzle-orm": "^0.45.2",
    "htmlparser2": "^10.0.0",
    "posthog-node": "^5.38.8",
    "react": "^19",
    "react-dom": "^19",
    "turndown": "^7.2.1",
    "web-push-neo": "^0.1.2",
    "workers-ai-provider": "^3.3.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.16.0",
    "@cloudflare/workers-types": "^4.20260511.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/turndown": "^5.0.5",
    "@typescript/native-preview": "7.0.0-dev.20260629.1",
    "drizzle-kit": "0.31.10",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^29.1.1",
    "oxfmt": "^0.56.0",
    "oxlint": "^0.13.0",
    "tsx": "^4.21.0",
    "typescript": "^5.6.0",
    "vite": "^8.0.12",
    "vitest": "^4.1.0",
    "wrangler": "^4.90.0"
  },
  "packageManager": "pnpm@9.12.0"
}
